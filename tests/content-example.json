              "heading": { "text": "Facilities", "level": 2 },
              "anchor": "facilities",
              "label": "Facilities",
              "list_kind": "ul"
            },
            {
              "heading": { "text": "Events", "level": 2 },
              "anchor": "events",
              "label": "Events",
              "list_kind": "ul"
            },
            {
              "heading": { "text": "Results", "level": 2 },
              "anchor": "results",
              "label": "Results",
              "list_kind": "ul"
            }
          ]
        }
      ]
    },
    "guide": {
      "enabled": true,
      "pages": [
        {
          "selector": { "meta": "_fixture_guide", "value": "festival-visit" },

msgstr "添加分组"

msgid "Add link"
msgstr "添加链接"

msgid "Add to group"
msgstr "添加到分组"

msgid "All records"
msgstr "全部记录"

msgid "Article"
msgstr "文章"

msgid "Browser storage is unavailable. Device reading is paused."
msgstr "浏览器存储不可用，已暂停本机阅读记录。"

